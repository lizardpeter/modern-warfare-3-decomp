+/// Bit-fields in allocation order. A PDB records a bit-field's position from the least significant bit of its
+/// base type, and lists members in declaration order. Big-endian compilers (the Xbox 360's MSVC) allocate from the
+/// most significant bit, except where a type was declared with `#pragma bitfield_order(lsb_to_msb)`, so a run of
+/// bit-fields sharing one storage unit (same offset and size) whose positions decrease was allocated from the most
+/// significant bit. Grouping bit-fields into unnamed structs and filling gaps work in allocation order; BitPos
+/// comments keep the PDB's position. A single bit-field takes the order of the type's other runs. Little-endian
+/// PDBs (positions always increase) are unchanged.
+pub(crate) fn with_bitfield_allocation_order<'p>(fields: &[Field<'p>]) -> Vec<Field<'p>> {
+    let mut out = fields.to_vec();
+    let mut runs: Vec<Range<usize>> = vec![];
+    let mut type_lsb_first: Option<bool> = None;
+    let position = |f: &Field| f.bitfield_info.map(|b| b.0).unwrap_or(0);
+    let mut i = 0;
+    while i < out.len() {
+        if out[i].bitfield_info.is_none() {
+            i += 1;
+            continue;
+        }
+        let mut end = i + 1;
+        while end < out.len()
+            && out[end].bitfield_info.is_some()
+            && out[end].offset == out[i].offset
+            && out[end].bitfield_base_size == out[i].bitfield_base_size
+        {
+            end += 1;
+        }
+        if end - i > 1 && type_lsb_first.is_none() {
+            type_lsb_first = Some(position(&out[i + 1]) > position(&out[i]));
+        }
+        runs.push(i..end);
+        i = end;
+    }
+    for run in runs {
+        let lsb_first = if run.len() > 1 {
+            position(&out[run.start + 1]) > position(&out[run.start])
+        } else {
+            type_lsb_first.unwrap_or(true)
+        };
+        for k in run {
+            let (pos, bits) = out[k].bitfield_info.unwrap_or_default();
+            out[k].lsb_first = lsb_first;
+            out[k].alloc_bit_offset = if lsb_first {
+                pos
+            } else {
+                ((out[k].bitfield_base_size * 8) as u8)
+                    .saturating_sub(pos)
+                    .saturating_sub(bits)
+            };
+        }
+    }
+    out
+}
+
+/// The PDB bit position (from the least significant bit) of `bits` bits at `alloc_offset` in allocation order,
+/// in the run `field` belongs to.
+fn bit_position(field: &Field, alloc_offset: u8, bits: u8) -> u8 {
+    if field.lsb_first {
+        alloc_offset
+    } else {
+        ((field.bitfield_base_size * 8) as u8)
+            .saturating_sub(alloc_offset)
+            .saturating_sub(bits)
+    }
+}
