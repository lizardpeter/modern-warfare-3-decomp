# VMX128 instruction fields, inserted into ppc_common.sinc's `define token instr(32)` by
# tools/ghidra/xenon/build_language.py (SLEIGH can't combine fields of two tokens in one pattern, and VMX128
# constructors use the PowerPC token's OP, XOP and register fields alongside these). LSB-0.
	x_op=(26,31)
	x_b0_1=(0,1)
	x_b0_3=(0,3)
	x_b4=(4,4)
	x_b4_5=(4,5)
	x_b4_10=(4,10)
	x_b5=(5,5)
	x_b6=(6,6)
	x_b6_7=(6,7)
	x_b6_8=(6,8)
	x_b6_9=(6,9)
	x_b7_9=(7,9)
	x_b8_10=(8,10)
	x_b9=(9,9)
	x_b9_10=(9,10)
	x_b10=(10,10)
	x_b21_25=(21,25)
	vd128h=(2,3)
	vd128l_1=(21,25)
	vd128l_2=(21,25)
	vd128l_3=(21,25)
	va128h=(5,5)
	va128H=(10,10)
	va128l_1=(16,20)
	va128l_2=(16,20)
	va128l_3=(16,20)
	vb128h=(0,1)
	vb128l_1=(11,15)
	vb128l_2=(11,15)
	vb128l_3=(11,15)
	vc128=(6,8)
	vc128n=(6,8)
	x_uimm5=(16,20)
	x_simm5=(16,20) signed
	x_sh4=(6,9)
	x_z=(6,7)
	x_permh=(6,8)
	x_perml=(16,20)
	x_rc6=(6,6)
